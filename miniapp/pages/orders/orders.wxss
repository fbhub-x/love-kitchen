/* orders.wxss - 订单页样式 */

.container {
  min-height: 100vh;
  background: #fff5f5;
  display: flex;
  flex-direction: column;
}

/* 订单内容区 */
.orders-content {
  flex: 1;
  padding: 12px 16px 80px;
  overflow-y: auto;
}

/* 统计卡片 */
.stats-cards {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 12px;
  padding: 14px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  box-shadow: 0 2px 8px rgba(255, 107, 129, 0.06);
}

.stat-num {
  font-size: 24px;
  font-weight: 700;
  color: #ff6b81;
}

.stat-label {
  font-size: 12px;
  color: #999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.empty-state-icon {
  font-size: 56px;
}

.empty-state-text {
  font-size: 16px;
  color: #999;
}

.empty-state-hint {
  font-size: 13px;
  color: #ccc;
}

/* 订单卡片 */
.order-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(255, 107, 129, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid #f5f0f0;
}

.order-id {
  font-size: 13px;
  color: #999;
  font-weight: 500;
}

.order-status {
  font-size: 12px;
  padding: 3px 10px;
  border-radius: 10px;
  font-weight: 500;
}

.status-pending {
  background: #fff4e6;
  color: #ff9500;
}

.status-cooking {
  background: #e6f7ff;
  color: #1890ff;
}

.status-completed {
  background: #f6ffed;
  color: #52c41a;
}

/* 订单菜品列表 */
.order-items {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.order-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px;
  background: #fafafa;
  border-radius: 8px;
}

.order-item-emoji {
  font-size: 28px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff5f5;
  border-radius: 8px;
  flex-shrink: 0;
}

.order-item-name {
  flex: 1;
  font-size: 14px;
  color: #333;
  font-weight: 500;
}

.order-item-qty {
  font-size: 14px;
  color: #ff6b81;
  font-weight: 600;
}

/* 备注 */
.order-note {
  margin-top: 10px;
  padding: 8px 12px;
  background: #fffbe6;
  border-radius: 8px;
  font-size: 13px;
  color: #666;
}

/* 时间 */
.order-time {
  margin-top: 10px;
  font-size: 12px;
  color: #ccc;
}

.order-time text {
  font-size: 12px;
  color: #ccc;
}

/* 厨师操作按钮 */
.order-actions {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

.action-start-btn {
  flex: 1;
  background: linear-gradient(135deg, #4a90d9, #357abd) !important;
  color: #fff !important;
  border-radius: 20px;
  padding: 10px;
  font-size: 14px;
  font-weight: 600;
  border: none;
  line-height: 1.5;
}

.action-start-btn::after {
  border: none;
}

.action-done-btn {
  flex: 1;
  background: linear-gradient(135deg, #52c41a, #389e0d) !important;
  color: #fff !important;
  border-radius: 20px;
  padding: 10px;
  font-size: 14px;
  font-weight: 600;
  border: none;
  line-height: 1.5;
}

.action-done-btn::after {
  border: none;
}

/* 空菜品提示 */
.order-empty-items {
  font-size: 13px;
  color: #ccc;
  padding: 8px;
}

/* 男方蓝色主题 */
.boy-header {
  background: #4a90d9 !important;
}

.boy-header text {
  color: #fff !important;
}

.boy-header .back-btn {
  color: #fff !important;
}
