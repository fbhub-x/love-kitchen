<view class="container">
  <!-- 顶部导航 -->
  <view class="app-header {{role === 'boy' ? 'boy-header' : ''}}">
    <view style="width:36px;"></view>
    <text>订单记录</text>
    <view style="width:36px;"></view>
  </view>

  <!-- 订单内容 -->
  <view class="orders-content">
    <!-- 统计卡片 -->
    <view class="stats-cards">
      <view class="stat-card" wx:if="{{role === 'boy'}}">
        <text class="stat-num">{{stats.pending}}</text>
        <text class="stat-label">待接单</text>
      </view>
      <view class="stat-card" wx:if="{{role === 'boy'}}">
        <text class="stat-num">{{stats.cooking}}</text>
        <text class="stat-label">制作中</text>
      </view>
      <view class="stat-card" wx:if="{{role === 'boy'}}">
        <text class="stat-num">{{stats.completed}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-card" wx:if="{{role !== 'boy'}}">
        <text class="stat-num">{{stats.total}}</text>
        <text class="stat-label">下单数</text>
      </view>
      <view class="stat-card" wx:if="{{role !== 'boy'}}">
        <text class="stat-num">{{stats.cooking}}</text>
        <text class="stat-label">制作中</text>
      </view>
      <view class="stat-card" wx:if="{{role !== 'boy'}}">
        <text class="stat-num">{{stats.completed}}</text>
        <text class="stat-label">已完成</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orders.length === 0}}">
      <text class="empty-state-icon">📋</text>
      <text class="empty-state-text">暂无订单</text>
      <text class="empty-state-hint" wx:if="{{role !== 'boy'}}">快去下单给Ta吧~</text>
      <text class="empty-state-hint" wx:if="{{role === 'boy'}}">等待Ta给你下单中~</text>
    </view>

    <!-- 订单列表 -->
    <block wx:else>
      <view class="order-card" wx:for="{{orders}}" wx:key="orderId">
        <view class="order-header">
          <text class="order-id">订单号: {{item.orderId}}</text>
          <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
        </view>

        <!-- 订单菜品列表 -->
        <view class="order-items" wx:if="{{item.items.length > 0}}">
          <view class="order-item" wx:for="{{item.items}}" wx:for-item="goods" wx:for-index="goodsIdx" wx:key="goodsIdx">
            <text class="order-item-emoji">{{goods.emoji}}</text>
            <text class="order-item-name">{{goods.name}}</text>
            <text class="order-item-qty">x{{goods.count}}</text>
          </view>
        </view>

        <view class="order-items" wx:else>
          <text class="order-empty-items">无菜品信息</text>
        </view>

        <!-- 备注 -->
        <view class="order-note" wx:if="{{item.note}}">
          <text class="order-note-text">📝 {{item.note}}</text>
        </view>

        <!-- 时间 -->
        <view class="order-time">
          <text class="order-time-text">{{item.timeText}}</text>
        </view>

        <!-- 厨师操作按钮 -->
        <view class="order-actions" wx:if="{{role === 'boy' && item.status !== 'completed'}}">
          <button class="action-start-btn" wx:if="{{item.status === 'pending'}}" bindtap="onStartCooking" data-id="{{item.orderId}}">开始制作</button>
          <button class="action-done-btn" wx:if="{{item.status === 'cooking' || item.status === 'pending'}}" bindtap="onComplete" data-id="{{item.orderId}}">完成</button>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部导航 -->
  <view class="bottom-nav" wx:if="{{role === 'boy'}}">
    <view class="nav-btn" bindtap="onGoHome">
      <text class="nav-icon">🏠</text>
      <text>首页</text>
    </view>
    <view class="nav-btn active">
      <text class="nav-icon">📋</text>
      <text>全部订单</text>
    </view>
    <view class="nav-btn" bindtap="onGoToDishes">
      <text class="nav-icon">🍽️</text>
      <text>菜品管理</text>
    </view>
  </view>

  <!-- 女方底部导航 -->
  <view class="bottom-nav" wx:else>
    <view class="nav-btn" bindtap="onGoHome">
      <text class="nav-icon">🏠</text>
      <text>首页</text>
    </view>
    <view class="nav-btn active">
      <text class="nav-icon">📋</text>
      <text>订单</text>
    </view>
  </view>
</view>
