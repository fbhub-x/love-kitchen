/* settings.wxss - 设置页样式 */

.page-container {
  height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.settings-scroll {
  flex: 1;
  overflow: hidden;
}

.settings-content {
  padding: 16px;
  padding-bottom: 80px;
}

/* ===== 用户卡片 ===== */
.settings-user-card {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-radius: var(--radius-lg);
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 20px;
  box-shadow: 0 4px 12px rgba(255, 107, 129, 0.2);
}

.settings-avatar {
  width: 64px;
  height: 64px;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  text-align: center;
}

.settings-avatar-emoji {
  font-size: 38px;
  line-height: 1;
  text-align: center;
}

.settings-avatar-img {
  width: 64px;
  height: 64px;
  border-radius: 50%;
}

.settings-user-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.settings-nickname {
  font-size: 18px;
  font-weight: 600;
  color: #fff;
}

.settings-role {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.2);
  padding: 2px 10px;
  border-radius: 10px;
  align-self: flex-start;
}

/* ===== 设置区块 ===== */
.settings-section {
  background: #fff;
  border-radius: var(--radius-lg);
  margin-bottom: 16px;
  overflow: hidden;
}

.settings-section-title {
  font-size: 13px;
  color: var(--text-secondary);
  font-weight: 600;
  padding: 12px 16px 6px;
  display: block;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid var(--border);
  gap: 8px;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item text:first-child {
  flex: 1;
  font-size: 15px;
  color: var(--text);
}

.settings-value {
  font-size: 13px;
  color: var(--text-secondary);
}

.settings-arrow {
  font-size: 16px;
  color: var(--text-light);
}

/* ===== 伴侣信息 ===== */
.partner-info-area {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
}

.partner-avatar {
  width: 44px;
  height: 44px;
  background: #fff0f3;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  text-align: center;
}

.partner-avatar-emoji {
  font-size: 26px;
  line-height: 1;
  text-align: center;
}

.partner-avatar-img {
  width: 44px;
  height: 44px;
  border-radius: 50%;
}

.partner-detail {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.partner-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.partner-status {
  font-size: 12px;
  color: var(--success);
}

/* ===== 未绑定状态 ===== */
.no-partner {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
}

.no-partner-icon {
  font-size: 20px;
}

.no-partner-text {
  font-size: 14px;
  color: var(--text-secondary);
}

/* 去绑定按钮 */
.go-bind-btn {
  background: linear-gradient(135deg, #ff6b81, #ff8fa3);
  border-radius: 20px;
  padding: 8px 20px;
  flex-shrink: 0;
}

.go-bind-btn text {
  color: #fff;
  font-size: 13px;
  font-weight: 600;
}

/* ===== 解绑按钮 ===== */
.unbind-btn {
  flex: 1;
  background: #fff0f3;
  border-radius: var(--radius-sm);
  padding: 10px;
  text-align: center;
}

.unbind-btn text {
  color: var(--danger);
  font-size: 14px;
  font-weight: 500;
}

/* ===== 退出登录 ===== */
.logout-item text:first-child {
  color: var(--danger);
}

.delete-account-item text:first-child {
  color: var(--danger);
}

/* ===== 男方蓝色主题 ===== */
.boy-theme {
  --primary: #4a90d9;
  --primary-light: #6ba8e8;
  --primary-dark: #357abd;
  --bg: #f0f4f8;
  --border: #e0e8f0;
}

.boy-theme .settings-user-card {
  background: linear-gradient(135deg, #4a90d9, #357abd);
  box-shadow: 0 4px 12px rgba(74, 144, 217, 0.2);
}

.boy-theme .app-header {
  background: #4a90d9;
}

.boy-theme .app-header text {
  color: #fff;
}

.boy-theme .edit-btn-save {
  background: linear-gradient(135deg, #4a90d9, #357abd);
}

.boy-theme .go-bind-btn {
  background: linear-gradient(135deg, #4a90d9, #357abd);
}

/* 修改密码弹窗 */
.pwd-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 20px;
  z-index: 9999;
}

.pwd-modal-content {
  background: #fff;
  border-radius: 20px;
  width: 85%;
  padding: 24px 20px 20px;
}

.modal-title {
  font-size: 18px;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20px;
  color: #333;
}

.pwd-field {
  margin-bottom: 16px;
  position: relative;
}

.pwd-label {
  font-size: 12px;
  color: #999;
  display: block;
  text-align: center;
  margin-bottom: 8px;
}

.pwd-box-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6px;
}

.pwd-box {
  width: 32px;
  height: 38px;
  border: 2px solid #e8e8e8;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fafafa;
  transition: all 0.2s;
  position: relative;
}

.pwd-box-filled {
  border-color: #ff6b81;
  background: #fff5f7;
}

.pwd-box-cursor {
  border-color: #ff6b81;
  background: #fff5f7;
}

.pwd-box-cursor::after {
  content: '';
  position: absolute;
  width: 2px;
  height: 16px;
  background: #ff6b81;
  border-radius: 1px;
  animation: pwdCursorBlink 1s step-end infinite;
}

@keyframes pwdCursorBlink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

.pwd-box-sep {
  width: 4px;
  height: 2px;
  background: #ddd;
  border-radius: 1px;
}

.pwd-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ff6b81;
  animation: dotPop 0.2s ease;
}

@keyframes dotPop {
  from { transform: scale(0); }
  to { transform: scale(1); }
}

.pwd-hidden-input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  left: -100px;
  top: 0;
}

.pwd-btns {
  display: flex;
  gap: 12px;
  margin-top: 8px;
}

.pwd-btn-cancel {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  background: #f5f5f5;
  color: #666;
  font-size: 15px;
  border: none;
  padding: 0;
}

.pwd-btn-cancel::after {
  border: none;
}

.pwd-btn-confirm {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  background: linear-gradient(135deg, #ff6b81, #ff8fa3);
  color: #fff;
  font-size: 15px;
  border: none;
  padding: 0;
}

.pwd-btn-confirm::after {
  border: none;
}

/* 心碎弹窗 */
.unbind-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  animation: overlayFadeIn 0.3s ease;
}

@keyframes overlayFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.unbind-heart {
  font-size: 64px;
  animation: heartBreak 0.8s ease;
}

@keyframes heartBreak {
  0% { transform: scale(0); opacity: 0; }
  30% { transform: scale(1.3); opacity: 1; }
  50% { transform: scale(1.1) rotate(-5deg); }
  70% { transform: scale(1.2) rotate(5deg); }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

.unbind-text {
  color: #fff;
  font-size: 18px;
  font-weight: 600;
  margin-top: 20px;
  animation: textFadeUp 0.5s ease 0.4s both;
}

@keyframes textFadeUp {
  from { transform: translateY(15px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.boy-theme .edit-avatar-btn {
  border-color: #b0d0f0;
  background: #f0f7ff;
}

/* ===== 编辑提示 ===== */
.edit-hint {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.8);
  flex-shrink: 0;
  margin-left: auto;
  padding-right: 4px;
}

/* ===== 编辑弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 20px 20px 0 0;
  padding: 24px 20px calc(32px + env(safe-area-inset-bottom));
  width: 100%;
}

.modal-title {
  font-size: 18px;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24px;
  color: #333;
}

/* 头像选择 */
.edit-avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20px;
}

.edit-avatar-preview {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff5f7, #ffe8ec);
  border: 3px solid #ffd0d8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
}

.edit-avatar-tip {
  font-size: 12px;
  color: #bbb;
  margin-top: 8px;
  margin-bottom: 12px;
}

.edit-emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
  max-width: 300px;
}

.edit-emoji-item {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  transition: all 0.2s;
  border: 2px solid transparent;
}

.edit-emoji-item:active {
  transform: scale(0.88);
}

.edit-emoji-item-active {
  background: linear-gradient(135deg, #fff0f3, #ffe0e6);
  border-color: #ff6b81;
  box-shadow: 0 2px 8px rgba(255, 107, 129, 0.25);
  transform: scale(1.1);
}

/* 昵称输入 */
.edit-form-row {
  margin-bottom: 24px;
  display: flex;
  flex-direction: column;
}

.edit-form-label {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.edit-form-input {
  background: #f8f8f8;
  border: 1px solid #eee;
  border-radius: 10px;
  padding-left: 16px;
  padding-right: 16px;
  font-size: 15px;
  width: 100%;
  height: 50px;
  line-height: 50px;
  box-sizing: border-box;
  color: #333;
}

/* 按钮 */
.edit-btns {
  display: flex;
  gap: 12px;
}

.edit-btn-cancel {
  flex: 1;
  background: #f5f5f5;
  border-radius: 24px;
  padding: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-btn-cancel text {
  color: #999;
  font-size: 15px;
}

.edit-btn-save {
  flex: 2;
  background: linear-gradient(135deg, #ff6b81, #ff8fa3);
  border-radius: 24px;
  padding: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-btn-save text {
  color: #fff;
  font-size: 15px;
  font-weight: 600;
}
