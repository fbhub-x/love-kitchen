/* girl-home page-specific styles - 所有类名唯一，不与 app.wxss 冲突 */

/* 页面容器 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #fff5f5;
}

/* 菜单布局区域 */
.dish-layout {
  display: flex;
  flex: 1;
  height: 0;
  min-height: 0;
  overflow: hidden;
  margin: 0;
  gap: 0;
}

/* 左侧分类栏 */
.dish-sidebar {
  width: 76px;
  flex-shrink: 0;
  background: #f5f0f2;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 0;
  overflow-y: auto;
}

.dish-sidebar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 12px 4px;
  border-radius: 10px;
  margin: 0 6px;
}

.dish-sidebar-active {
  background: #fff;
  color: #ff6b81;
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  position: relative;
}

.dish-sidebar-active::before {
  content: '';
  position: absolute;
  left: -6px;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 20px;
  background: #ff6b81;
  border-radius: 0 2px 2px 0;
}

.dish-sidebar-icon {
  font-size: 22px;
  line-height: 1;
}

.dish-sidebar-label {
  font-size: 11px;
  white-space: nowrap;
}

/* 右侧菜品滚动区 */
.dish-scroll {
  flex: 1;
  padding: 0 10px 80px;
  box-sizing: border-box;
}

.dish-scroll-inner {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-top: 4px;
}

/* 分类分组 */
.dish-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.dish-group-title {
  font-size: 14px;
  font-weight: 700;
  color: #333;
  padding: 4px;
}

/* 菜品卡片 */
.dish-item-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #fff;
  border-radius: 12px;
  padding: 12px;
  box-shadow: 0 2px 8px rgba(255, 107, 129, 0.06);
}

.dish-item-emoji {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  background: linear-gradient(135deg, #fff5f7, #ffe0e6);
  flex-shrink: 0;
}

.dish-item-info {
  flex: 1;
  min-width: 0;
}

.dish-item-name {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  margin-bottom: 2px;
}

.dish-item-desc {
  font-size: 12px;
  color: #999;
  margin-bottom: 6px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-item-time {
  font-size: 12px;
  color: #999;
}

/* +号添加按钮 */
.dish-add-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b81, #ff8fa3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(255, 107, 129, 0.35);
  transition: transform 0.15s ease;
  position: relative;
}

.dish-add-text {
  font-size: 20px;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.dish-add-hover {
  transform: scale(0.88);
  box-shadow: 0 1px 4px rgba(255, 107, 129, 0.2);
}

/* +号波纹弹跳动画 */
.dish-add-pop {
  animation: btnRipple 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes btnRipple {
  0% { transform: scale(1); box-shadow: 0 2px 8px rgba(255, 107, 129, 0.35); }
  30% { transform: scale(1.3); box-shadow: 0 0 0 6px rgba(255, 107, 129, 0.15), 0 4px 16px rgba(255, 107, 129, 0.5); }
  60% { transform: scale(0.95); box-shadow: 0 2px 8px rgba(255, 107, 129, 0.35); }
  100% { transform: scale(1); box-shadow: 0 2px 8px rgba(255, 107, 129, 0.35); }
}

/* ===== 飞入购物车动画球 ===== */
.fly-ball {
  position: fixed;
  z-index: 9999;
  pointer-events: none;
  opacity: 0;
  /* 用 translate(-50%,-50%) 居中到坐标点 */
  transform: translate(-50%, -50%) scale(0.5);
  transition: none;
}

.fly-ball-inner {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff5f7, #ffe0e6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(255, 107, 129, 0.4);
  border: 2px solid #ff6b81;
}

.fly-ball-inner text {
  font-size: 22px;
  line-height: 1;
}

/* 起始状态：在点击位置，放大出现 */
.fly-ball-start {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  transition: transform 0.15s ease-out, opacity 0.1s ease;
}

/* 飞行状态：抛物线飞向购物车，同时缩小 */
.fly-ball-flying {
  opacity: 1;
  transform: translate(-50%, -50%) scale(0.3) rotate(360deg);
  transition: transform 0.55s cubic-bezier(0.5, 0, 0.9, 0.6),
              left 0.55s cubic-bezier(0.4, 0, 0.8, 0.6),
              top 0.55s cubic-bezier(0.4, 0, 0.9, 0.6),
              opacity 0.45s ease-in 0.1s;
}

/* ===== 购物车弹跳 ===== */
.cart-bounce {
  animation: cartShake 0.4s ease;
}

@keyframes cartShake {
  0%, 100% { transform: scale(1); }
  25% { transform: scale(1.2) rotate(-8deg); }
  50% { transform: scale(0.95) rotate(5deg); }
  75% { transform: scale(1.05) rotate(-2deg); }
}

/* badge 弹出 */
.badge-pop {
  animation: badgePop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes badgePop {
  0% { transform: scale(1); }
  40% { transform: scale(1.5); background: #ff4757; }
  100% { transform: scale(1); }
}

/* 通知弹窗 */
.notif-popup {
  position: fixed;
  top: 12%;
  left: 16px;
  right: 16px;
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  z-index: 9999;
  animation: notifSlideIn 0.4s ease;
}

@keyframes notifSlideIn {
  from { transform: translateY(-100px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.notif-icon {
  font-size: 36px;
  flex-shrink: 0;
  animation: notifBounce 0.6s ease infinite alternate;
}

@keyframes notifBounce {
  from { transform: translateY(0); }
  to { transform: translateY(-4px); }
}

.notif-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.notif-title {
  font-size: 16px;
  font-weight: 700;
  color: #333;
}

.notif-desc {
  font-size: 13px;
  color: #999;
}

.notif-close {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #ccc;
  flex-shrink: 0;
}

/* 空状态 */
.dish-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 80px 20px;
}

.dish-empty-icon {
  font-size: 56px;
}

.dish-empty-text {
  font-size: 14px;
  color: #999;
}

/* ========================================
   以下为 girl-home 购物车改造新增样式
   所有 class 使用 gh- 前缀避免冲突
   ======================================== */

/* ===== 菜品卡片「选规格」按钮 ===== */
.gh-spec-btn {
  padding: 4px 12px;
  border-radius: 14px;
  background: linear-gradient(135deg, #ff6b81, #ff8fa3);
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.4;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(255, 107, 129, 0.35);
  transition: transform 0.15s ease;
}

.gh-spec-btn-hover {
  transform: scale(0.92);
  opacity: 0.85;
}

/* ===== 菜品卡片「- 数量 +」步进器 ===== */
.gh-stepper {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.gh-stepper-btn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 700;
  line-height: 1;
  transition: transform 0.12s ease;
}

.gh-stepper-btn:active {
  transform: scale(0.85);
}

.gh-stepper-minus {
  background: #fff;
  color: #ff6b81;
  border: 2px solid #ff6b81;
  box-sizing: border-box;
}

.gh-stepper-plus {
  background: linear-gradient(135deg, #ff6b81, #ff8fa3);
  color: #fff;
  box-shadow: 0 2px 6px rgba(255, 107, 129, 0.3);
}

.gh-stepper-num {
  min-width: 20px;
  text-align: center;
  font-size: 15px;
  font-weight: 700;
  color: #333;
}

/* ===== 购物车底部栏 ===== */
.gh-cart-bar {
  flex-shrink: 0;
  height: 52px;
  background: #fff;
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 100;
}

/* 购物车为空 */
.gh-cart-empty {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
}

.gh-cart-empty-text {
  font-size: 13px;
  color: #bbb;
}

/* 购物车有商品 */
.gh-cart-bar-inner {
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 12px;
  gap: 8px;
}

.gh-cart-icon-wrap {
  position: relative;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b81, #ff8fa3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2px 10px rgba(255, 107, 129, 0.35);
  margin-top: -10px;
}

.gh-cart-icon {
  font-size: 22px;
  line-height: 1;
}

.gh-cart-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  border-radius: 9px;
  background: #ff4757;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
  border: 2px solid #fff;
  box-sizing: border-box;
}

.gh-cart-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.gh-cart-total-num {
  font-size: 14px;
  font-weight: 600;
  color: #333;
}

.gh-cart-checkout-btn {
  flex-shrink: 0;
  padding: 10px 24px;
  border-radius: 20px;
  background: linear-gradient(135deg, #ff6b81, #ff8fa3);
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  box-shadow: 0 2px 10px rgba(255, 107, 129, 0.35);
  transition: transform 0.12s ease;
}

.gh-cart-checkout-btn:active {
  transform: scale(0.95);
}

/* ===== 遮罩层 ===== */
.gh-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.gh-mask-show {
  opacity: 1;
  pointer-events: auto;
}

/* ===== 规格选择面板 ===== */
.gh-spec-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 16px 16px 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.gh-spec-panel-show {
  transform: translateY(0);
}

/* 规格面板头部 */
.gh-spec-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
  flex-shrink: 0;
}

.gh-spec-dish-emoji {
  width: 56px;
  height: 56px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  background: linear-gradient(135deg, #fff5f7, #ffe0e6);
  flex-shrink: 0;
}

.gh-spec-dish-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.gh-spec-dish-name {
  font-size: 16px;
  font-weight: 700;
  color: #333;
}

.gh-spec-dish-desc {
  font-size: 12px;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.gh-spec-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #ccc;
  flex-shrink: 0;
}

/* 规格面板主体 */
.gh-spec-body {
  padding: 12px 16px;
  overflow-y: auto;
  flex: 1;
}

.gh-spec-group {
  margin-bottom: 16px;
}

.gh-spec-group:last-child {
  margin-bottom: 0;
}

.gh-spec-group-title {
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 10px;
}

.gh-spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.gh-spec-option {
  padding: 6px 16px;
  border-radius: 8px;
  background: #f5f5f5;
  font-size: 13px;
  color: #666;
  border: 2px solid transparent;
  transition: all 0.2s ease;
}

.gh-spec-option-active {
  background: #fff0f3;
  color: #ff6b81;
  border-color: #ff6b81;
  font-weight: 600;
}

/* 规格面板底部 */
.gh-spec-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px;
