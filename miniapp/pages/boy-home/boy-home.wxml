<view class="page-container">
  <!-- 顶部蓝色导航栏 -->
  <view class="app-header">
    <text>爱心厨房</text>
    <view class="header-actions">
      <view class="icon-btn" bindtap="onGoToOrders">📋</view>
      <view class="icon-btn" bindtap="onSwitchRole">🔄</view>
      <view class="icon-btn" bindtap="onGoToSettings">⚙️</view>
    </view>
  </view>

  <!-- 欢迎横幅 -->
  <view class="welcome-banner">
    <text class="banner-emoji">👨‍🍳</text>
    <view>今天也要加油做菜哦！</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-cards">
    <view class="stat-card">
      <text class="stat-num">{{stats.pending}}</text>
      <text class="stat-label">待接单</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.cooking}}</text>
      <text class="stat-label">制作中</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.completed}}</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="orders-content">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orders.length === 0}}">
      <text class="empty-state-icon">🍳</text>
      <text class="empty-state-text">暂无订单</text>
      <text class="empty-state-hint">等待Ta给你下单~</text>
    </view>

    <!-- 订单卡片 -->
    <block wx:else>
      <view class="order-card" wx:for="{{orders}}" wx:key="orderId">
        <view class="order-header">
          <text class="order-id">订单号: {{item.orderId}}</text>
          <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
        </view>

        <!-- 菜品列表 -->
        <view class="order-items">
          <view class="order-item" wx:for="{{item.items}}" wx:for-item="goods" wx:for-index="idx" wx:key="idx">
            <text class="order-item-emoji">{{goods.emoji}}</text>
            <text>{{goods.name}} x{{goods.count}}</text>
          </view>
        </view>

        <!-- 备注 -->
        <view class="order-note" wx:if="{{item.note}}">
          <text>📝 {{item.note}}</text>
        </view>

        <!-- 时间 -->
        <view class="order-time">
          <text>{{item.timeText}}</text>
        </view>

        <!-- 操作按钮 -->
        <view class="order-actions" wx:if="{{item.status !== 'completed'}}">
          <button class="start-btn" wx:if="{{item.status === 'pending'}}" bindtap="onStartCooking" data-id="{{item.orderId}}">开始制作</button>
          <button class="done-btn" wx:if="{{item.status === 'cooking' || item.status === 'pending'}}" bindtap="onComplete" data-id="{{item.orderId}}">完成</button>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部导航栏 -->
  <view class="bottom-nav">
    <view class="nav-btn active">
      <text class="nav-icon">🏠</text>
      <text>首页</text>
    </view>
    <view class="nav-btn" bindtap="onGoToOrders">
      <text class="nav-icon">📋</text>
      <text>全部订单</text>
    </view>
    <view class="nav-btn" bindtap="onGoToDishes">
      <text class="nav-icon">🍽️</text>
      <text>菜品管理</text>
    </view>
  </view>

  <!-- 新订单通知弹窗 -->
  <view class="notif-popup {{showNotif ? 'notif-show' : ''}}" wx:if="{{showNotif}}">
    <view class="notif-icon">{{notifIcon}}</view>
    <view class="notif-content">
      <text class="notif-title">{{notifTitle}}</text>
      <text class="notif-desc">{{notifDesc}}</text>
    </view>
    <view class="notif-close" bindtap="closeNotif">✕</view>
  </view>
</view>
