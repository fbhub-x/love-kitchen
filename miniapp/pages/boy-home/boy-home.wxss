/* boy-home.wxss - 厨师端首页样式，与女方完全不同 */

.page-container {
  min-height: 100vh;
  background: #f0f4f8;
  display: flex;
  flex-direction: column;
}

/* ========== 顶部蓝色导航 ========== */
.app-header {
  background: #4a90d9 !important;
}

.app-header text {
  color: #fff !important;
}

.header-actions .icon-btn {
  background: rgba(255, 255, 255, 0.2) !important;
}

/* ========== 欢迎横幅 ========== */
.welcome-banner {
  background: linear-gradient(135deg, #4a90d9, #357abd) !important;
  margin: 12px 16px;
  border-radius: 16px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 4px 12px rgba(74, 144, 217, 0.2);
}

.welcome-banner view {
  color: #fff;
  font-size: 16px;
  font-weight: 500;
}

.banner-emoji {
  font-size: 36px;
}

/* ========== 统计卡片 ========== */
.stats-cards {
  display: flex;
  gap: 10px;
  padding: 0 16px;
  margin-bottom: 16px;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 12px;
  padding: 16px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  box-shadow: 0 2px 8px rgba(74, 144, 217, 0.08);
}

.stat-num {
  font-size: 28px;
  font-weight: 700;
  color: #4a90d9;
}

.stat-label {
  font-size: 12px;
  color: #999;
}

/* ========== 订单列表 ========== */
.orders-content {
  flex: 1;
  padding: 0 16px 80px;
  overflow-y: auto;
}

.order-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(74, 144, 217, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid #f0f4f8;
}

.order-id {
  font-size: 13px;
  color: #999;
  font-weight: 500;
}

.order-status {
  font-size: 12px;
  padding: 3px 10px;
  border-radius: 10px;
  font-weight: 500;
}

.status-pending {
  background: #fff4e6;
  color: #ff9500;
}

.status-cooking {
  background: #e6f7ff;
  color: #1890ff;
}

.status-completed {
  background: #f6ffed;
  color: #52c41a;
}

/* 菜品列表 */
.order-items {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.order-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px;
  background: #f8fafd;
  border-radius: 8px;
}

.order-item-emoji {
  font-size: 28px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f0fa;
  border-radius: 8px;
  flex-shrink: 0;
}

.order-item text:nth-child(2) {
  flex: 1;
  font-size: 14px;
  color: #333;
  font-weight: 500;
}

/* 备注 */
.order-note {
  margin-top: 10px;
  padding: 8px 12px;
  background: #fffbe6;
  border-radius: 8px;
  font-size: 13px;
  color: #666;
}

.order-note text {
  font-size: 13px;
  color: #666;
}

/* 时间 */
.order-time {
  margin-top: 8px;
  font-size: 12px;
  color: #ccc;
}

.order-time text {
  font-size: 12px;
  color: #ccc;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

.start-btn {
  flex: 1;
  background: linear-gradient(135deg, #4a90d9, #357abd) !important;
  color: #fff !important;
  border-radius: 20px;
  padding: 10px;
  font-size: 14px;
  font-weight: 600;
  border: none;
  line-height: 1.5;
}

.start-btn::after {
  border: none;
}

.done-btn {
  flex: 1;
  background: linear-gradient(135deg, #52c41a, #389e0d) !important;
  color: #fff !important;
  border-radius: 20px;
  padding: 10px;
  font-size: 14px;
  font-weight: 600;
  border: none;
  line-height: 1.5;
}

.done-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.empty-state-icon {
  font-size: 56px;
}

.empty-state-text {
  font-size: 16px;
  color: #999;
}

.empty-state-hint {
  font-size: 13px;
  color: #ccc;
}

/* 通知弹窗 */
.notif-popup {
  position: fixed;
  top: 12%;
  left: 16px;
  right: 16px;
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 8px 32px rgba(74, 144, 217, 0.2);
  z-index: 9999;
  animation: notifSlideIn 0.4s ease;
}

@keyframes notifSlideIn {
  from { transform: translateY(-100px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.notif-icon {
  font-size: 36px;
  flex-shrink: 0;
  animation: notifBounce 0.6s ease infinite alternate;
}

@keyframes notifBounce {
  from { transform: translateY(0); }
  to { transform: translateY(-4px); }
}

.notif-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.notif-title {
  font-size: 16px;
  font-weight: 700;
  color: #333;
}

.notif-desc {
  font-size: 13px;
  color: #999;
}

.notif-close {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #ccc;
  flex-shrink: 0;
}
